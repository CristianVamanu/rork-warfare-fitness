# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Next.js
.next/
# Transient build dirs used by deploy.sh's staged build + atomic swap
.next-staging/
.next-previous/
out/
dist/

# Expo (legacy)
.expo/
web-build/
expo-env.d.ts

# Native
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# local env files
.env*.local

# typescript
*.tsbuildinfo
.vercel

ios/
android/
.rork
.env
rork-eslint.config.js
.claude/

# Local Firestore backup dumps (only written when R2 isn't configured — see
# /api/admin/backup) — full user data, never belongs in git.
/backups/

# Firebase emulator artifacts
firebase-debug.log
firestore-debug.log
ui-debug.log
