# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# dependencies
node_modules/

# Next.js
.next/
# Transient build dirs used by deploy.sh's staged build + atomic swap
.next-staging/
.next-previous/
out/
dist/

# Expo (legacy)
.expo/
web-build/
expo-env.d.ts

# Native
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# Metro
.metro-health-check*

# debug
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store
*.pem

# Firebase password hash parameters (RESTORE.md tells you to create this).
# It is the key that makes every password hash in every backup usable — the
# one thing deliberately kept OUT of backups, so committing it here would
# undo that entirely. Belongs in a password manager, not in git.
hash-params.json

# A restored/downloaded backup is the whole database, password hashes included.
restore.jsonl.gz
backup-*.jsonl.gz
backup-*.json
backups/

# written by deploy.sh / deploy-webhook, read by /api/health
.deploy-status.json

# deploy.sh's out-of-place dependency install (see "Installing dependencies").
# .node-modules-lock-hash records which package-lock.json produced the tree
# currently on disk, so a deploy that changes no dependencies doesn't delete
# node_modules out from under the running server.
.node-modules-lock-hash
.npm-staging/
.node-modules-previous/

# Generated by next-pwa at build time — never edit or commit these.
# Committing them meant the repo carried a service worker whose precache
# manifest named a specific build id (_next/static/<buildId>/...). Any deploy
# that stopped between `git reset --hard` and the sw swap would then serve
# that stale worker, which 404s on every asset it tries to precache:
#   bad-precaching-response :: [{"url":".../_buildManifest.js","status":404}]
# deploy.sh regenerates all of these on every build, so nothing needs them
# in git.
public/sw.js
public/sw.js.map
public/workbox-*.js
public/workbox-*.js.map
public/worker-*.js
public/worker-*.js.map

# local env files
.env*.local

# typescript
*.tsbuildinfo
.vercel

ios/
android/
.rork
.env
rork-eslint.config.js
.claude/

# Local Firestore backup dumps (only written when R2 isn't configured — see
# /api/admin/backup) — full user data, never belongs in git.
/backups/

# Firebase emulator artifacts
firebase-debug.log
firestore-debug.log
ui-debug.log
