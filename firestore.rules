rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/system/config)
        && get(/databases/$(database)/documents/system/config).data.adminUid == request.auth.uid;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // system/config
    // READ   - any authenticated user (needed for isSetupComplete, checkIsAdmin, installer)
    // CREATE - any authenticated user, only when doc does not exist yet (first install)
    // UPDATE - stored adminUid only, adminUid field is immutable
    // DELETE - never
    match /system/config {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
                    && !exists(/databases/$(database)/documents/system/config);
      allow update: if request.auth != null
                    && request.auth.uid == resource.data.adminUid
                    && request.resource.data.adminUid == resource.data.adminUid;
      allow delete: if false;
    }

    // App-level settings
    match /warfare_admin/{docId} {
      allow read:  if request.auth != null;
      allow write: if isAdmin();
    }

    // User profiles
    match /users/{userId} {
      allow read:   if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
                    && !('isAdmin' in request.resource.data);
      allow update: if (isOwner(userId)
                        && !request.resource.data.diff(resource.data).affectedKeys()
                            .hasAny(['isAdmin', 'trainerApproved', 'trainerRevenueSplit']))
                    || isAdmin();
      allow delete: if isAdmin();

      match /workoutLogs/{logId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /meals/{mealId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /trainingState/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // Workouts
    match /workouts/{workoutId} {
      allow read:  if request.auth != null;
      allow write: if isAdmin();
    }

    // Meals / nutrition
    match /meals/{mealId} {
      allow read:   if isOwner(resource.data.userId) || isAdmin();
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId) || isAdmin();
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // Community channels
    match /channels/{channelId} {
      allow read:  if request.auth != null;
      allow write: if isAdmin();

      match /messages/{messageId} {
        allow read:   if request.auth != null;
        allow create: if request.auth != null
                      && request.auth.uid == request.resource.data.userId;
        allow update: if isOwner(resource.data.userId) || isAdmin();
        allow delete: if isOwner(resource.data.userId) || isAdmin();
      }
    }

    // Subscriptions (Admin SDK / Stripe webhook only)
    match /subscriptions/{userId} {
      allow read:  if isOwner(userId) || isAdmin();
      allow write: if false;
    }

    // Community posts
    match /community/{postId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
                    && request.auth.uid == request.resource.data.userId;
      allow update: if isOwner(resource.data.userId) || isAdmin();
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }
  }
}
