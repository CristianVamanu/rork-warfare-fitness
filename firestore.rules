rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ────────────────────────────────────────────────────────────────

    // Admin = the uid stored in system/config.adminUid.
    // Single source of truth. No custom claims. No isAdmin fields.
    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/system/config)
        && get(/databases/$(database)/documents/system/config).data.adminUid == request.auth.uid;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // True if the installer has NOT been completed yet (no system/config exists).
    function isFirstInstall() {
      return !exists(/databases/$(database)/documents/system/config);
    }

    // ─── System config ───────────────────────────────────────────────────────────
    //
    // Read:   only the admin (or during first install, any auth'd user to derive isAdmin)
    // Create: only if doc doesn't exist yet — allows installer to write it once
    // Update: only admin (e.g. to update openAiKey or stripeConfig later)
    // Delete: never
    match /system/config {
      allow read:   if isAdmin() || isFirstInstall();
      allow create: if request.auth != null && isFirstInstall();
      allow update: if isAdmin()
        // Guard: no one can change adminUid after installation
        && request.resource.data.adminUid == resource.data.adminUid;
      allow delete: if false;
    }

    // ─── App-level settings (trainer branding, feature flags) ────────────────────
    match /warfare_admin/{docId} {
      allow read:  if request.auth != null;
      allow write: if isAdmin();
    }

    // ─── User profiles ────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read:   if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        // Clients can never write isAdmin, trainerApproved, or trainerRevenueSplit
        && !('isAdmin' in request.resource.data);
      allow update: if (isOwner(userId)
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['isAdmin', 'trainerApproved', 'trainerRevenueSplit']))
        || isAdmin();
      allow delete: if isAdmin();

      match /workoutLogs/{logId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /meals/{mealId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /trainingState/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // ─── Workouts (trainer-created templates) ─────────────────────────────────────
    match /workouts/{workoutId} {
      allow read:  if request.auth != null;
      allow write: if isAdmin();
    }

    // ─── Meals / nutrition ────────────────────────────────────────────────────────
    match /meals/{mealId} {
      allow read:   if isOwner(resource.data.userId) || isAdmin();
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId) || isAdmin();
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // ─── Community ────────────────────────────────────────────────────────────────
    match /channels/{channelId} {
      allow read:  if request.auth != null;
      allow write: if isAdmin();

      match /messages/{messageId} {
        allow read:   if request.auth != null;
        allow create: if request.auth != null
          && request.auth.uid == request.resource.data.userId;
        allow update: if isOwner(resource.data.userId) || isAdmin();
        allow delete: if isOwner(resource.data.userId) || isAdmin();
      }
    }

    // ─── Subscriptions (written by Stripe webhook via Admin SDK only) ─────────────
    match /subscriptions/{userId} {
      allow read:  if isOwner(userId) || isAdmin();
      allow write: if false;
    }

    // ─── Community posts ──────────────────────────────────────────────────────────
    match /community/{postId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
      allow update: if isOwner(resource.data.userId) || isAdmin();
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }
  }
}
