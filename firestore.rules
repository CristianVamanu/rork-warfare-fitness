rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ───────────────────────────────────────────────────────────
    function isAuthed() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // Reads the caller's user doc (one extra read — used only for role checks)
    function callerRole() {
      return get(/databases/$(database)/documents/users/$(uid())).data.get('role', 'user');
    }

    function isAdmin() {
      return isAuthed() && callerRole() == 'admin';
    }

    function isStaff() {
      return isAuthed() && (callerRole() == 'admin' || callerRole() == 'trainer');
    }

    // ── System config ─────────────────────────────────────────────────────
    // installer doc must be publicly readable (checked before auth exists)
    match /system/installer {
      allow read:  if true;
      allow write: if isAuthed();   // admin is signed in by the time this is written
    }

    // Publicly readable — branding (app name, logo) needs to render on the
    // public landing/login/register pages before anyone is signed in. Every
    // field here is meant to be public anyway (Stripe publishable key and
    // VAPID public key are, by design, safe to expose client-side).
    match /system/config {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // Encrypted third-party API keys (OpenAI, Stripe, R2, VAPID, etc).
    // Admin-only read+write — values are AES-256-GCM ciphertext, decryptable
    // only server-side with ENCRYPTION_KEY, but no reason to expose them at all.
    match /system/secrets {
      allow read:  if isAdmin();
      allow write: if isAdmin();
    }

    // Catch-all for any other system docs
    match /system/{doc} {
      allow read:  if isAuthed();
      allow write: if isAdmin();
    }

    // ── Users ─────────────────────────────────────────────────────────────
    // Read is open to any authenticated user (not just self/admin) so the
    // leaderboard can query the whole users collection — this is a single
    // community app where members already see each other's names/stats in
    // channels. Trade-off: email is technically readable by any signed-in
    // member via direct Firestore calls, not just through the app UI.
    match /users/{userId} {
      allow read:   if isAuthed();
      allow create: if isAuthed() && uid() == userId;
      allow update: if isAuthed() && (uid() == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // ── Tenants ───────────────────────────────────────────────────────────
    // All authenticated users need to read their trainer's tenant (subscription status)
    match /tenants/{trainerId} {
      allow read:  if isAuthed();
      allow write: if isAdmin();
    }

    // ── Events — single write path for all activity tracking ─────────────
    match /events/{eventId} {
      // Read: own events or admin
      allow read: if isAuthed() && (resource.data.userId == uid() || isAdmin());

      // Create: userId must match caller; required fields must be present
      allow create: if isAuthed()
        && request.resource.data.userId == uid()
        && request.resource.data.keys().hasAll(['type', 'userId', 'trainerId', 'payload', 'createdAt']);

      // Delete: own events only (e.g. undo a log entry)
      allow delete: if isAuthed() && resource.data.userId == uid();

      // Events are immutable once created
      allow update: if false;
    }

    // ── Programs ──────────────────────────────────────────────────────────
    match /programs/{programId} {
      allow read:  if isAuthed();
      allow write: if isAdmin();
    }

    // ── Community posts ───────────────────────────────────────────────────
    match /posts/{postId} {
      allow read:   if isAuthed();
      allow create: if isAuthed() && request.resource.data.userId == uid();
      allow update: if isAuthed() && (resource.data.userId == uid() || isAdmin());
      allow delete: if isAuthed() && (resource.data.userId == uid() || isAdmin());
    }

    // ── Conversations — admin-initiated DMs ──────────────────────────────
    match /conversations/{convId} {
      allow read: if isAuthed() && (
        resource.data.adminId == uid() ||
        resource.data.userId == uid()
      );
      allow create: if isAdmin();
      allow update: if isAuthed() && (
        resource.data.adminId == uid() ||
        resource.data.userId == uid()
      );
      // Either side of the conversation can delete it
      allow delete: if isAuthed() && (
        resource.data.adminId == uid() ||
        resource.data.userId == uid()
      );

      match /messages/{msgId} {
        allow read: if isAuthed() && (
          get(/databases/$(database)/documents/conversations/$(convId)).data.adminId == uid() ||
          get(/databases/$(database)/documents/conversations/$(convId)).data.userId == uid()
        );
        allow create: if isAuthed()
          && request.resource.data.senderId == uid()
          && (
            isAdmin() ||
            get(/databases/$(database)/documents/conversations/$(convId)).data.userId == uid()
          );
        allow update: if false;
        // Deleting a message requires the parent conversation to still exist,
        // so this only fires as part of deleteConversation() clearing the
        // subcollection before the parent doc — same ownership check.
        allow delete: if isAuthed() && (
          get(/databases/$(database)/documents/conversations/$(convId)).data.adminId == uid() ||
          get(/databases/$(database)/documents/conversations/$(convId)).data.userId == uid()
        );
      }
    }

    // ── Legacy collections — read + delete only ───────────────────────────
    // No new creates or updates. Delete allowed so UI delete buttons still
    // work on pre-migration docs before events are backfilled.

    match /meals/{mealId} {
      allow read:   if isAuthed() && resource.data.userId == uid();
      allow delete: if isAuthed() && resource.data.userId == uid();
      // create / update blocked — all new writes go through events
      allow create, update: if false;
    }

    match /waterLogs/{logId} {
      allow read:   if isAuthed() && resource.data.userId == uid();
      allow delete: if isAuthed() && resource.data.userId == uid();
      allow create, update: if false;
    }

    match /workoutLogs/{logId} {
      allow read:   if isAuthed() && resource.data.userId == uid();
      // workout history is not deletable
      allow write:  if false;
    }

    // ── Weight logs ───────────────────────────────────────────────────────
    match /weightLogs/{logId} {
      allow read:   if isAuthed() && resource.data.userId == uid();
      allow create: if isAuthed() && request.resource.data.userId == uid();
      allow update, delete: if false;
    }

    // ── Habit tracker ─────────────────────────────────────────────────────
    // Doc ID is `${userId}_${date}` — checking the ID itself (not
    // resource.data) means reads work even for days that were never
    // logged, where the document doesn't exist yet. A resource.data check
    // fails closed as permission-denied on a nonexistent doc, since
    // `resource` is null when there's nothing to read.
    match /habitLogs/{logId} {
      allow read: if isAuthed() && logId.split('_')[0] == uid();
      allow create: if isAuthed() && request.resource.data.userId == uid();
      allow update: if isAuthed() && resource.data.userId == uid();
      allow delete: if false;
    }

    // ── Channels (Discord-style community) ────────────────────────────────
    match /channels/{channelId} {
      allow read: if isAuthed();
      allow create, update, delete: if isAdmin();

      match /posts/{postId} {
        allow read: if isAuthed();
        // Announcement-only channels (allowUserPosts == false) restrict
        // top-level posts to admin/trainer; missing field defaults to allowed
        // so pre-existing channels aren't retroactively locked.
        allow create: if isAuthed()
          && request.resource.data.userId == uid()
          && (
            isAdmin() ||
            get(/databases/$(database)/documents/channels/$(channelId)).data.get('allowUserPosts', true) == true
          );
        allow update: if isAuthed() && resource.data.userId == uid();
        allow delete: if isAdmin();

        match /replies/{replyId} {
          allow read: if isAuthed();
          allow create: if isAuthed() && request.resource.data.userId == uid();
          allow update, delete: if false;
        }
      }

      match /members/{userId} {
        allow read, write: if isAuthed();
      }
    }

    // ── Notifications ─────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read, update: if isAuthed() && resource.data.userId == uid();
      allow create: if isAdmin();
      allow delete: if isAuthed() && (resource.data.userId == uid() || isAdmin());
    }

    // ── 1:1 Coaching applications (intake form → admin review) ───────────
    match /coachingApplications/{appId} {
      allow read: if isAuthed() && (resource.data.userId == uid() || isAdmin());
      allow create: if isAuthed() && request.resource.data.userId == uid();
      allow update, delete: if isAdmin();
    }

    // ── Config documents (membership, hiddenMocks, etc.) ─────────────────
    match /config/{configId} {
      // membership + coachingPlans + membershipPlans power the public
      // pricing section on the logged-out landing page — everything else in
      // this collection (notifications, hiddenMocks) stays authed-only.
      allow read: if isAuthed() || configId in ['membership', 'coachingPlans', 'membershipPlans'];
      allow write: if isAdmin();
    }

    // ── Push subscriptions ────────────────────────────────────────────────
    match /pushSubscriptions/{userId} {
      allow read, write: if isAuthed() && uid() == userId;
      allow read: if isAdmin();
    }

    // ── User preferences (theme, etc.) ────────────────────────────────────
    match /userPreferences/{userId} {
      allow read, write: if isAuthed() && uid() == userId;
    }

    // ── Exercise video library ────────────────────────────────────────────
    match /exerciseLibrary/{videoId} {
      allow read:  if isAuthed();
      allow write: if isAdmin();
    }

    // ── PR Wall — community-posted personal records (trust/verification) ──
    // Read is authed-only here; the public/pending split (only approved
    // posts + your own pending one) is filtered client-side, not by rule.
    function prBanActive() {
      let ban = get(/databases/$(database)/documents/users/$(uid())).data.get('prBan', null);
      return ban != null && (ban.until == null || ban.until > request.time);
    }

    match /prPosts/{postId} {
      allow read:   if isAuthed();
      allow create: if isAuthed()
        && request.resource.data.userId == uid()
        && request.resource.data.moderationStatus == 'pending'
        && !prBanActive();
      // Only admins can touch moderation/verification state (that's the
      // whole point of the review gate) — the app never lets a post's own
      // author edit it, only delete it, so there's no legitimate case for
      // an author-owns-it update clause here. Anyone signed in can still
      // bump likeCount.
      allow update: if isAuthed() && (
        isAdmin() ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount'])
      );
      allow delete: if isAuthed() && (resource.data.userId == uid() || isAdmin());
    }

    // ── Client goals (trainer/admin sets, client checks in on progress) ───
    match /goals/{goalId} {
      allow read: if isAuthed() && (resource.data.userId == uid() || isStaff());
      allow create: if isStaff();
      // Client can only touch currentValue on their own goal (status is
      // still coach-controlled — e.g. marking it missed); staff can edit
      // anything.
      allow update: if isAuthed() && (
        isStaff() ||
        (resource.data.userId == uid() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentValue']))
      );
      allow delete: if isStaff();
    }

    // Body progress photos — private to the owning user and staff (admin/trainer) only.
    match /progressPhotos/{photoId} {
      allow read:   if isAuthed() && (resource.data.userId == uid() || isStaff());
      allow create: if isAuthed() && request.resource.data.userId == uid();
      allow delete: if isAuthed() && (resource.data.userId == uid() || isAdmin());
    }

  }
}
