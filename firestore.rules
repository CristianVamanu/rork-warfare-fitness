rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers (used by all collections EXCEPT system/config) ──────────────
    //
    // isAdmin() reads system/config via get(). Do NOT use it inside the
    // system/config match block itself — that causes a circular get() on the
    // document being created/updated and produces permission errors during the
    // first-install bootstrap.

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/system/config)
        && get(/databases/$(database)/documents/system/config).data.adminUid == request.auth.uid;
    }

    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // ─── system/config ────────────────────────────────────────────────────────
    //
    // Rules are written WITHOUT calling isAdmin() to avoid circular get().
    //
    // READ:
    //   A) Before first install: doc doesn't exist → any authenticated user can
    //      read (needed so isSetupComplete() works client-side).
    //   B) After install: only the stored adminUid can read (sensitive keys).
    //
    // CREATE:
    //   Only when the document does NOT exist yet (first-install bootstrap).
    //   Any authenticated user is allowed — the installer creates the admin
    //   account in Step 2, then writes system/config in Step 5.
    //
    // UPDATE:
    //   Only the stored adminUid. adminUid field is IMMUTABLE after creation.
    //
    // DELETE:
    //   Never.

    match /system/config {
      allow read: if
        // Pre-install: doc doesn't exist, allow read so client can detect first-run
        !exists(/databases/$(database)/documents/system/config)
        ||
        // Post-install: admin only
        (request.auth != null && request.auth.uid == resource.data.adminUid);

      allow create: if
        // Bootstrap: doc must not exist yet, user must be authenticated
        request.auth != null
        && !exists(/databases/$(database)/documents/system/config);

      allow update: if
        // Admin only; adminUid cannot be changed after installation
        request.auth != null
        && request.auth.uid == resource.data.adminUid
        && request.resource.data.adminUid == resource.data.adminUid;

      allow delete: if false;
    }

    // ─── App-level settings (trainer branding, feature flags) ────────────────
    match /warfare_admin/{docId} {
      allow read:  if request.auth != null;
      allow write: if isAdmin();
    }

    // ─── User profiles ────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read:   if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && !('isAdmin' in request.resource.data);
      allow update: if (isOwner(userId)
          && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['isAdmin', 'trainerApproved', 'trainerRevenueSplit']))
        || isAdmin();
      allow delete: if isAdmin();

      match /workoutLogs/{logId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /meals/{mealId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }

      match /trainingState/{docId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // ─── Workouts (trainer-created templates) ─────────────────────────────────
    match /workouts/{workoutId} {
      allow read:  if request.auth != null;
      allow write: if isAdmin();
    }

    // ─── Meals / nutrition ────────────────────────────────────────────────────
    match /meals/{mealId} {
      allow read:   if isOwner(resource.data.userId) || isAdmin();
      allow create: if isOwner(request.resource.data.userId);
      allow update: if isOwner(resource.data.userId) || isAdmin();
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // ─── Community ────────────────────────────────────────────────────────────
    match /channels/{channelId} {
      allow read:  if request.auth != null;
      allow write: if isAdmin();

      match /messages/{messageId} {
        allow read:   if request.auth != null;
        allow create: if request.auth != null
          && request.auth.uid == request.resource.data.userId;
        allow update: if isOwner(resource.data.userId) || isAdmin();
        allow delete: if isOwner(resource.data.userId) || isAdmin();
      }
    }

    // ─── Subscriptions (Stripe webhook via Admin SDK only) ────────────────────
    match /subscriptions/{userId} {
      allow read:  if isOwner(userId) || isAdmin();
      allow write: if false;
    }

    // ─── Community posts ──────────────────────────────────────────────────────
    match /community/{postId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
      allow update: if isOwner(resource.data.userId) || isAdmin();
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }
  }
}
