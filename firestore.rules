rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ───────────────────────────────────────────────────────────
    function isAuthed() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // Reads the caller's user doc (one extra read — used only for role checks)
    function callerRole() {
      return get(/databases/$(database)/documents/users/$(uid())).data.get('role', 'user');
    }

    function isAdmin() {
      return isAuthed() && callerRole() == 'admin';
    }

    // ── System config ─────────────────────────────────────────────────────
    // installer doc must be publicly readable (checked before auth exists)
    match /system/installer {
      allow read:  if true;
      allow write: if isAuthed();   // admin is signed in by the time this is written
    }

    match /system/config {
      allow read:  if isAuthed();
      allow write: if isAdmin();
    }

    // Catch-all for any other system docs
    match /system/{doc} {
      allow read:  if isAuthed();
      allow write: if isAdmin();
    }

    // ── Users ─────────────────────────────────────────────────────────────
    match /users/{userId} {
      allow read:   if isAuthed() && (uid() == userId || isAdmin());
      allow create: if isAuthed() && uid() == userId;
      allow update: if isAuthed() && (uid() == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // ── Tenants ───────────────────────────────────────────────────────────
    // All authenticated users need to read their trainer's tenant (subscription status)
    match /tenants/{trainerId} {
      allow read:  if isAuthed();
      allow write: if isAdmin();
    }

    // ── Events — single write path for all activity tracking ─────────────
    match /events/{eventId} {
      // Read: own events or admin
      allow read: if isAuthed() && (resource.data.userId == uid() || isAdmin());

      // Create: userId must match caller; required fields must be present
      allow create: if isAuthed()
        && request.resource.data.userId == uid()
        && request.resource.data.keys().hasAll(['type', 'userId', 'trainerId', 'payload', 'createdAt']);

      // Delete: own events only (e.g. undo a log entry)
      allow delete: if isAuthed() && resource.data.userId == uid();

      // Events are immutable once created
      allow update: if false;
    }

    // ── Programs ──────────────────────────────────────────────────────────
    match /programs/{programId} {
      allow read:  if isAuthed();
      allow write: if isAdmin();
    }

    // ── Community posts ───────────────────────────────────────────────────
    match /posts/{postId} {
      allow read:   if isAuthed();
      allow create: if isAuthed() && request.resource.data.userId == uid();
      allow update: if isAuthed() && (resource.data.userId == uid() || isAdmin());
      allow delete: if isAuthed() && (resource.data.userId == uid() || isAdmin());
    }

    // ── Conversations — admin-initiated DMs ──────────────────────────────
    match /conversations/{convId} {
      allow read: if isAuthed() && (
        resource.data.adminId == uid() ||
        resource.data.userId == uid()
      );
      allow create: if isAdmin();
      allow update: if isAuthed() && (
        resource.data.adminId == uid() ||
        resource.data.userId == uid()
      );
      allow delete: if isAdmin();

      match /messages/{msgId} {
        allow read: if isAuthed() && (
          get(/databases/$(database)/documents/conversations/$(convId)).data.adminId == uid() ||
          get(/databases/$(database)/documents/conversations/$(convId)).data.userId == uid()
        );
        allow create: if isAuthed()
          && request.resource.data.senderId == uid()
          && (
            isAdmin() ||
            get(/databases/$(database)/documents/conversations/$(convId)).data.userId == uid()
          );
        allow update, delete: if false;
      }
    }

    // ── Legacy collections — read + delete only ───────────────────────────
    // No new creates or updates. Delete allowed so UI delete buttons still
    // work on pre-migration docs before events are backfilled.

    match /meals/{mealId} {
      allow read:   if isAuthed() && resource.data.userId == uid();
      allow delete: if isAuthed() && resource.data.userId == uid();
      // create / update blocked — all new writes go through events
      allow create, update: if false;
    }

    match /waterLogs/{logId} {
      allow read:   if isAuthed() && resource.data.userId == uid();
      allow delete: if isAuthed() && resource.data.userId == uid();
      allow create, update: if false;
    }

    match /workoutLogs/{logId} {
      allow read:   if isAuthed() && resource.data.userId == uid();
      // workout history is not deletable
      allow write:  if false;
    }

    // ── Weight logs ───────────────────────────────────────────────────────
    match /weightLogs/{logId} {
      allow read:   if isAuthed() && resource.data.userId == uid();
      allow create: if isAuthed() && request.resource.data.userId == uid();
      allow update, delete: if false;
    }
  }
}
