rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin settings — authenticated users can read; writes via Admin SDK only.
    match /warfare_admin/{docId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // User profiles — each user reads/writes only their own document.
    // isAdmin is set by the Admin SDK only (client cannot escalate privileges).
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && !('isAdmin' in request.resource.data);
      allow update: if request.auth != null && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isAdmin', 'trainerApproved', 'trainerRevenueSplit']);

      // Workout logs subcollection
      match /workoutLogs/{logId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Meals subcollection
      match /meals/{mealId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Training state subcollection
      match /trainingState/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Subscriptions — each user reads only their own; writes via Admin SDK (Stripe webhook).
    match /subscriptions/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if false;
    }

    // Community channels — any authenticated user can read; authenticated users can write.
    // Message ownership enforcement is done in app code; stricter rules in Phase 3.
    match /channels/{channelId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null;

      match /messages/{messageId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
        allow update: if request.auth != null
          && (request.auth.uid == resource.data.userId || request.auth.uid == request.resource.data.userId);
        allow delete: if false;
      }
    }
  }
}
