rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ───────────────────────────────────────────────────────────
    function isAuthed() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    // The actual server-side enforcement for email-code 2FA (see
    // src/app/api/auth/2fa/*). Before this, 2FA was only a client-side
    // redirect (AppLayout checking twoFactorPendingSince) — a stolen
    // password alone was enough to skip the code entirely via a direct
    // SDK/REST call, since Firebase Auth already grants a fully valid
    // session the instant the password matches; nothing server-side ever
    // checked whether the code had actually been verified.
    //
    // login-check/verify set this custom claim (tfaPending) directly on the
    // Firebase Auth user via the admin SDK, and the client force-refreshes
    // its ID token (getIdToken(true)) right after each call so the claim
    // takes effect before the next Firestore request. Deliberately NOT
    // folded into isAuthed() itself — that's used everywhere including the
    // user's own profile read, which still has to succeed so the app can
    // render Settings/the /verify-2fa screen at all for a pending account.
    // Applied instead to every collection actually worth protecting
    // (workouts, meals, messages, photos, weight, PRs, goals) and to the
    // user's own profile UPDATE specifically — the exact write a stolen
    // session would otherwise use to just turn its own 2FA back off.
    function notTfaPending() {
      return request.auth.token.get('tfaPending', false) != true;
    }

    // Reads the caller's user doc (one extra read — used only for role checks).
    // Guarded with exists() first — calling .data on a get() result for a
    // document that doesn't exist THROWS in Firestore rules, which Firestore
    // reports to the client as a blanket "permission-denied", not a graceful
    // false/undefined. isAdmin() (which calls this) runs on every write to
    // users/{userId}, including a brand-new user's own first self-update
    // right after signup — if their own doc hadn't fully propagated to this
    // rule evaluation's view yet (e.g. racing the doc-creation write itself),
    // this call used to crash the whole rule instead of just resolving to
    // the sensible default ('user', i.e. not an admin).
    function callerRole() {
      return exists(/databases/$(database)/documents/users/$(uid()))
        ? get(/databases/$(database)/documents/users/$(uid())).data.get('role', 'user')
        : 'user';
    }

    function isAdmin() {
      return isAuthed() && callerRole() == 'admin';
    }

    // A trainer's staff access is meant to be scoped to their own assigned
    // clients (see users/{userId}.trainerId, already used to filter
    // programs/channels elsewhere) — not every client in the install. Admin
    // still sees everything. Used for the client-owned collections below
    // (goals, PT test results, progress photos) where a trainer previously
    // got blanket isStaff() access to every user's data regardless of who
    // that user's assigned trainer actually is.
    function isAdminOrOwnTrainer(clientUserId) {
      return isAdmin() || (
        isAuthed() && callerRole() == 'trainer' &&
        exists(/databases/$(database)/documents/users/$(clientUserId)) &&
        get(/databases/$(database)/documents/users/$(clientUserId)).data.get('trainerId', null) == uid()
      );
    }

    // True until the one-time /install wizard finishes — createAdminUser()
    // writes role:'admin' directly on the very first user doc, before any
    // admin account (and therefore any isAdmin() caller) exists yet. Scoping
    // the exception to "installer not done" closes it back down the moment
    // setup completes, same as every signup after that point.
    function installerNotDone() {
      return !exists(/databases/$(database)/documents/system/installer) ||
        get(/databases/$(database)/documents/system/installer).data.get('installed', false) != true;
    }

    // How many absolute program day-slots a non-member can advance into —
    // mirrors src/lib/membership.ts's getProgramDayLimit() so the client-side
    // padlock can't be bypassed by writing lastCompletedDayIndex directly.
    function trialDayLimit() {
      return exists(/databases/$(database)/documents/config/membership) &&
        get(/databases/$(database)/documents/config/membership).data.get('enabled', false) == true &&
        get(/databases/$(database)/documents/config/membership).data.get('trialDays', 0) > 0
        ? get(/databases/$(database)/documents/config/membership).data.get('trialDays', 0)
        : 999999;
    }

    // Mirrors useFeatureAccess.ts's `inTrial` — a signed-up account is
    // inside its free trial window for `trialDays` calendar days from
    // createdAt, same math as the client. During that window every
    // feature/program lock is bypassed there regardless of isPremium/price;
    // premiumEnrollAllowed() below needs this same bypass, or a trial user
    // can never actually enroll in a premium program at all — the client UI
    // would show it as unlocked while the server refused the write, which
    // is exactly the bug this closes.
    // Deliberately NOT gated on paidTrialEnabled. This helper is used in
    // exactly one place — premiumEnrollAllowed() — which decides which
    // program may be ASSIGNED to a user, not whether they may access it.
    // Access under a paid trial is enforced by fullLock + MembershipGuard
    // (an unpaid account can't reach /training at all), so assigning a
    // program is harmless and is a required step of the quiz -> plan
    // reveal -> checkout funnel: onboarding enrolls the user BEFORE they
    // ever reach Stripe. Gating this on paidTrialEnabled broke signup
    // outright — every new account got permission-denied on enrollInProgram
    // the moment paid trial was switched on, because a brand-new user has
    // no subscription yet by definition.
    function trialActive() {
      return exists(/databases/$(database)/documents/config/membership) &&
        get(/databases/$(database)/documents/config/membership).data.get('enabled', false) == true &&
        get(/databases/$(database)/documents/config/membership).data.get('trialDays', 0) > 0 &&
        resource.data.get('createdAt', null) != null &&
        resource.data.createdAt + duration.value(get(/databases/$(database)/documents/config/membership).data.get('trialDays', 0), 'd') > request.time;
    }

    // Only restricts writes that actually move activeProgram's completion
    // pointer forward past the trial cap — enrolling in a new program
    // (which resets lastCompletedDayIndex) or any unrelated field change is
    // always allowed.
    function activeProgramWriteAllowed() {
      return !('activeProgram' in request.resource.data.diff(resource.data).affectedKeys())
        || resource.data.get('membership', {}).get('status', 'none') == 'active'
        || resource.data.get('coaching', {}).get('status', 'none') == 'active'
        || request.resource.data.activeProgram.get('lastCompletedDayIndex', -1) < trialDayLimit();
    }

    // Mirrors isMembershipLocked in training/[id]/page.tsx — a program is
    // members-only if its own Firestore doc has isPremium:true, or its id
    // is in the admin's lockedProgramIds list. Only covers programs that
    // actually have a Firestore doc (i.e. have been promoted via Admin ->
    // Programs at least once, which is required to set isPremium in the
    // first place) — a built-in program's isPremium flag that only exists
    // in app code can't be checked here, since these rules only ever see
    // Firestore data. Promoting a premium program (clicking its crown/price
    // control) is what makes this actually enforced instead of just a
    // client-side suggestion.
    function programIsMembersOnly(programId) {
      return (exists(/databases/$(database)/documents/programs/$(programId))
          && get(/databases/$(database)/documents/programs/$(programId)).data.get('isPremium', false) == true)
        || (exists(/databases/$(database)/documents/config/membership)
          && get(/databases/$(database)/documents/config/membership).data.get('lockedProgramIds', []).hasAny([programId]));
    }

    // Same idea for a program with a one-time price set (pay-per-program,
    // independent of membership) — only meaningful for a promoted program
    // doc, same limitation as programIsMembersOnly above.
    function programPrice(programId) {
      return exists(/databases/$(database)/documents/programs/$(programId))
        ? get(/databases/$(database)/documents/programs/$(programId)).data.get('price', 0)
        : 0;
    }

    // Enrolling in (or switching to) a members-only or priced program
    // requires an active membership/coaching subscription, or — for a
    // priced program — a prior purchase. Previously nothing server-side
    // checked either of these; it was purely a client-side UI decision, so
    // any signed-in user could write straight into a gated program's
    // activeProgram field for free via the Firestore SDK directly,
    // bypassing the app UI entirely.
    // Only gates a write that's actually newly enrolling/switching into a
    // program — matched by comparing against the PRE-write programId, not
    // just checking 'programId' is present. Before this fix, that presence
    // check meant EVERY subsequent workout-completion write to an already-
    // enrolled program (advancing completedWorkouts/lastCompletedDayIndex,
    // not touching programId at all) re-ran the full membership/purchase
    // gate too — so a membership lapsing mid-program silently froze that
    // user's progress on every future workout, even though nothing about
    // their enrollment itself changed.
    function premiumEnrollAllowed() {
      return !('activeProgram' in request.resource.data.diff(resource.data).affectedKeys())
        || !('programId' in request.resource.data.activeProgram)
        || request.resource.data.activeProgram.programId == resource.data.get('activeProgram', {}).get('programId', null)
        || resource.data.get('membership', {}).get('status', 'none') == 'active'
        || resource.data.get('coaching', {}).get('status', 'none') == 'active'
        || (
          // trialActive() bypasses ONLY the members-only/locked-program
          // gate here, matching useFeatureAccess.ts exactly — a one-time
          // priced program still requires an actual purchase (or price 0)
          // even during trial; trial isn't a substitute for buying it.
          (!programIsMembersOnly(request.resource.data.activeProgram.programId) || trialActive())
          && (
            programPrice(request.resource.data.activeProgram.programId) <= 0
            || resource.data.get('purchasedProgramIds', []).hasAny([request.resource.data.activeProgram.programId])
          )
        );
    }

    // ── System config ─────────────────────────────────────────────────────
    // installer doc must be publicly readable (checked before auth exists)
    match /system/installer {
      allow read:  if true;
      // Only writable before install completes, or by an already-confirmed
      // admin — otherwise any authed client could flip `installed` back to
      // false and re-trigger the installer flow.
      allow write: if isAdmin() || installerNotDone();
    }

    // Publicly readable — branding (app name, logo) needs to render on the
    // public landing/login/register pages before anyone is signed in. Every
    // field here is meant to be public anyway (Stripe publishable key and
    // VAPID public key are, by design, safe to expose client-side).
    match /system/config {
      allow read:  if true;
      allow write: if isAdmin();
    }

    // Encrypted third-party API keys (OpenAI, Stripe, R2, VAPID, etc).
    // Admin-only read+write — values are AES-256-GCM ciphertext, decryptable
    // only server-side with ENCRYPTION_KEY, but no reason to expose them at all.
    match /system/secrets {
      allow read:  if isAdmin();
      allow write: if isAdmin();
    }

    // Catch-all for any other system docs
    match /system/{doc} {
      // Firestore rules are additive across match blocks, so this catch-all
      // must NOT match /system/secrets — otherwise this permissive read
      // silently overrides that doc's own isAdmin()-only lock above.
      allow read:  if doc != 'secrets' && isAuthed();
      allow write: if isAdmin();
    }

    // ── Users ─────────────────────────────────────────────────────────────
    match /users/{userId} {
      // Full profile docs hold email, biometrics, goals, membership/coaching
      // status and Stripe subscription ids — readable only by the owner and
      // admin/own-trainer. Anything other users need (leaderboard, "N people
      // trained today") is mirrored client-side into the separate
      // leaderboardPublic/{userId} doc below, which is field-limited by rule.
      allow read:   if isAuthed() && (uid() == userId || isAdminOrOwnTrainer(userId));
      // trainerId is deliberately allowed here (unlike role/membership/
      // purchasedProgramIds) — signUp() always writes it (possibly null),
      // and unlike those other fields it doesn't grant admin or paid access
      // by itself, so it's not the same kind of escalation risk. role:'admin'
      // is allowed ONLY while the installer hasn't finished yet — that's
      // createAdminUser()'s one-time bootstrap write, not a general escape
      // hatch for regular signups.
      allow create: if isAuthed() && uid() == userId
        && (request.resource.data.role == 'user' || (request.resource.data.role == 'admin' && installerNotDone()))
        && !('membership' in request.resource.data)
        && !('coaching' in request.resource.data)
        && !('purchasedProgramIds' in request.resource.data)
        && !('banned' in request.resource.data)
        && !('prBan' in request.resource.data);
      // Self-updates may touch their own profile/preferences/stats, but never
      // the privileged fields below — role, membership/coaching, and purchase
      // state are only ever meant to change via the Stripe webhook / admin
      // SDK (server-side, bypassing rules) or an admin action here. Without
      // this allow-list a signed-in user could call updateDoc() directly
      // from the client and grant themselves admin or an active paid
      // membership/coaching subscription for free.
      allow update: if isAuthed() && (
        isAdmin() ||
        (uid() == userId && notTfaPending() &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(
            ['role', 'membership', 'coaching', 'purchasedProgramIds', 'trainerId', 'banned', 'prBan', 'trialUsedAt']
          ) &&
          activeProgramWriteAllowed() &&
          premiumEnrollAllowed())
      );
      allow delete: if isAdmin();
    }

    // ── Leaderboard (public mirror) ──────────────────────────────────────
    // Field-limited copy of the leaderboard-relevant subset of a user's doc
    // (see src/lib/firestore.ts syncLeaderboardPublic) — readable by anyone
    // signed in, unlike the full users/{userId} doc above. `banned` is
    // deliberately excluded from the client-writable allowlist: only the
    // server-side ban-user route (firebase-admin, bypasses these rules) can
    // set it, so a banned user can't self-unban by writing to their own doc.
    match /leaderboardPublic/{userId} {
      allow read: if isAuthed();
      allow write: if isAdmin() || (
        isAuthed() && uid() == userId &&
        request.resource.data.keys().hasOnly(
          ['displayName', 'xp', 'powerLevel', 'streak', 'totalWorkouts', 'totalWeightLifted', 'questsCompleted', 'lastWorkoutDate']
        )
      );
    }

    // ── Community Live Activity (public, minimal) ─────────────────────────
    // Field-limited, append-only feed — never anything from the private
    // `events` collection (whose payload holds duration/calories/meal
    // contents etc). userId must be the caller's own EXCEPT for admin, who
    // posts on an athlete's behalf when approving a PR (setPRPostModeration
    // in src/lib/firestore.ts) — the athlete never runs that write
    // themselves. No update/delete from clients; only admin can clean up.
    match /communityActivity/{activityId} {
      allow read: if isAuthed();
      allow create: if isAuthed()
        && (request.resource.data.userId == uid() || isAdmin())
        && request.resource.data.keys().hasOnly(['userId', 'displayName', 'type', 'label', 'createdAt'])
        && request.resource.data.type in ['workout', 'program_day', 'program_completed', 'pr', 'achievement', 'quest', 'streak']
        && request.resource.data.label is string && request.resource.data.label.size() <= 200
        && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 100;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ── Tenants ───────────────────────────────────────────────────────────
    // All authenticated users need to read their trainer's tenant (subscription status)
    match /tenants/{trainerId} {
      allow read:  if isAuthed();
      allow write: if isAdmin();
    }

    // ── Events — single write path for all activity tracking ─────────────
    match /events/{eventId} {
      // Read: own events, admin, or that event's own trainer — needed for
      // the admin panel's client profile modal (Training Activity: recent
      // workout history), same scoping already used for goals/PT
      // results/progress photos below.
      allow read: if isAuthed() && notTfaPending() && (resource.data.userId == uid() || isAdminOrOwnTrainer(resource.data.userId));

      // Create: userId must match caller; required fields must be present
      allow create: if isAuthed() && notTfaPending()
        && request.resource.data.userId == uid()
        && request.resource.data.keys().hasAll(['type', 'userId', 'trainerId', 'payload', 'createdAt']);

      // Delete: own events only (e.g. undo a log entry)
      allow delete: if isAuthed() && notTfaPending() && resource.data.userId == uid();

      // Events are immutable once created
      allow update: if false;
    }

    // ── Programs ──────────────────────────────────────────────────────────
    match /programs/{programId} {
      allow read:  if isAuthed();
      allow write: if isAdmin();
    }

    // ── Community posts ───────────────────────────────────────────────────
    match /posts/{postId} {
      allow read:   if isAuthed();
      allow create: if isAuthed() && request.resource.data.userId == uid();
      allow update: if isAuthed() && (resource.data.userId == uid() || isAdmin());
      allow delete: if isAuthed() && (resource.data.userId == uid() || isAdmin());
    }

    // ── Conversations — staff-initiated only. A member can never create a
    // conversation (with staff or with another member) — only reply to one
    // staff already started. adminId must always be a real admin's own uid
    // (checked below), so a member can't forge a conversation that merely
    // looks staff-owned. There is no member-to-member path: every doc has
    // exactly one adminId (must satisfy isAdmin()) and one userId.
    // ─────────────────────────────────────────────────────────────────────
    match /conversations/{convId} {
      allow read: if isAuthed() && notTfaPending() && (
        resource.data.adminId == uid() ||
        resource.data.userId == uid()
      );
      allow create: if isAdmin() && notTfaPending() && request.resource.data.adminId == uid();
      allow update: if isAuthed() && notTfaPending() && (
        resource.data.adminId == uid() ||
        resource.data.userId == uid()
      );
      // Either side of the conversation can delete it
      allow delete: if isAuthed() && notTfaPending() && (
        resource.data.adminId == uid() ||
        resource.data.userId == uid()
      );

      match /messages/{msgId} {
        allow read: if isAuthed() && notTfaPending() && (
          get(/databases/$(database)/documents/conversations/$(convId)).data.adminId == uid() ||
          get(/databases/$(database)/documents/conversations/$(convId)).data.userId == uid()
        );
        // isFromAdmin must match the caller's actual role — otherwise a
        // member could write isFromAdmin:true and have their own reply
        // rendered/notified as if it came from staff.
        allow create: if isAuthed() && notTfaPending()
          && request.resource.data.senderId == uid()
          && request.resource.data.isFromAdmin == isAdmin()
          && (
            isAdmin() ||
            get(/databases/$(database)/documents/conversations/$(convId)).data.userId == uid()
          );
        allow update: if false;
        // Deleting a message requires the parent conversation to still exist,
        // so this only fires as part of deleteConversation() clearing the
        // subcollection before the parent doc — same ownership check.
        allow delete: if isAuthed() && notTfaPending() && (
          get(/databases/$(database)/documents/conversations/$(convId)).data.adminId == uid() ||
          get(/databases/$(database)/documents/conversations/$(convId)).data.userId == uid()
        );
      }
    }

    // ── Legacy collections — read + delete only ───────────────────────────
    // No new creates or updates. Delete allowed so UI delete buttons still
    // work on pre-migration docs before events are backfilled.

    match /meals/{mealId} {
      allow read:   if isAuthed() && notTfaPending() && resource.data.userId == uid();
      allow delete: if isAuthed() && notTfaPending() && resource.data.userId == uid();
      // create / update blocked — all new writes go through events
      allow create, update: if false;
    }

    match /waterLogs/{logId} {
      allow read:   if isAuthed() && notTfaPending() && resource.data.userId == uid();
      allow delete: if isAuthed() && notTfaPending() && resource.data.userId == uid();
      allow create, update: if false;
    }

    match /workoutLogs/{logId} {
      allow read:   if isAuthed() && notTfaPending() && resource.data.userId == uid();
      // workout history is not deletable
      allow write:  if false;
    }

    // ── Weight logs ───────────────────────────────────────────────────────
    match /weightLogs/{logId} {
      allow read:   if isAuthed() && notTfaPending() && resource.data.userId == uid();
      allow create: if isAuthed() && notTfaPending() && request.resource.data.userId == uid();
      allow update, delete: if false;
    }

    // ── Habit tracker ─────────────────────────────────────────────────────
    // Doc ID is `${userId}_${date}` — checking the ID itself (not
    // resource.data) means reads work even for days that were never
    // logged, where the document doesn't exist yet. A resource.data check
    // fails closed as permission-denied on a nonexistent doc, since
    // `resource` is null when there's nothing to read.
    match /habitLogs/{logId} {
      allow read: if isAuthed() && notTfaPending() && logId.split('_')[0] == uid();
      allow create: if isAuthed() && notTfaPending() && request.resource.data.userId == uid();
      allow update: if isAuthed() && notTfaPending() && resource.data.userId == uid();
      allow delete: if false;
    }

    // ── Channels (Discord-style community) ────────────────────────────────
    match /channels/{channelId} {
      allow read: if isAuthed() && notTfaPending();
      allow create, update, delete: if isAdmin();

      match /posts/{postId} {
        allow read: if isAuthed() && notTfaPending();
        // Announcement-only channels (allowUserPosts == false) restrict
        // top-level posts to admin/trainer; missing field defaults to allowed
        // so pre-existing channels aren't retroactively locked.
        // userIsAdmin must match the caller's actual role — otherwise any
        // member could write userIsAdmin:true and show the Admin badge on
        // their own post.
        allow create: if isAuthed() && notTfaPending()
          && request.resource.data.userId == uid()
          && request.resource.data.get('userIsAdmin', false) == isAdmin()
          && (
            isAdmin() ||
            get(/databases/$(database)/documents/channels/$(channelId)).data.get('allowUserPosts', true) == true
          );
        // Author can edit their own post; anyone signed in can like/unlike,
        // adding/removing exactly their own uid from `likes` — same
        // exact-delta pattern as prPosts, so a client can't like on
        // another user's behalf or forge the whole array.
        allow update: if isAuthed() && notTfaPending() && (
          resource.data.userId == uid() ||
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes']) &&
            (
              (request.resource.data.likes == resource.data.get('likes', []).concat([uid()])
                && !(uid() in resource.data.get('likes', []))) ||
              (request.resource.data.likes == resource.data.get('likes', []).removeAll([uid()])
                && (uid() in resource.data.get('likes', [])))
            ))
        );
        allow delete: if isAdmin();

        match /replies/{replyId} {
          allow read: if isAuthed() && notTfaPending();
          allow create: if isAuthed() && notTfaPending() && request.resource.data.userId == uid()
            && request.resource.data.get('userIsAdmin', false) == isAdmin();
          allow update, delete: if false;
        }
      }

      match /members/{userId} {
        allow read: if isAuthed() && notTfaPending();
        // Only ever writes its own lastPostAt slow-mode doc — scoped to
        // that so one member can't overwrite another's timestamp.
        allow write: if isAuthed() && notTfaPending() && uid() == userId;
      }
    }

    // ── Notifications ─────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read, update: if isAuthed() && resource.data.userId == uid();
      // Admins can notify anyone (broadcasts, PR-review results, etc). A
      // regular user can only create a notification whose recipient is
      // staff — covers submitCoachingApplication() notifying admins of a
      // new application — never another regular user (no spam vector).
      allow create: if isAdmin() ||
        (isAuthed() &&
          exists(/databases/$(database)/documents/users/$(request.resource.data.userId)) &&
          get(/databases/$(database)/documents/users/$(request.resource.data.userId)).data.get('role', 'user') in ['admin', 'trainer']);
      allow delete: if isAuthed() && (resource.data.userId == uid() || isAdmin());
    }

    // ── B2B trainer leads (public demo-request form → admin review) ─────
    match /trainerLeads/{leadId} {
      allow read, update, delete: if isAdmin();
      // Public form on the logged-out /trainers page — no auth yet at
      // submit time, so this can't check uid() like other creates. Locked
      // to exactly the expected shape/status instead of a wide-open create.
      // Length caps are a cheap ceiling against scripted spam filling the
      // doc (and the notification email) with huge payloads — the API
      // route's own rate limit is the real throttle, this is just a floor.
      allow create: if request.resource.data.status == 'new'
        && request.resource.data.keys().hasAll(['name', 'email', 'status', 'createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 200
        && request.resource.data.email is string && request.resource.data.email.size() > 0 && request.resource.data.email.size() <= 320
        && (!('businessName' in request.resource.data) || (request.resource.data.businessName is string && request.resource.data.businessName.size() <= 200))
        && (!('phone' in request.resource.data) || (request.resource.data.phone is string && request.resource.data.phone.size() <= 40))
        && (!('clientCount' in request.resource.data) || (request.resource.data.clientCount is string && request.resource.data.clientCount.size() <= 20))
        && (!('message' in request.resource.data) || (request.resource.data.message is string && request.resource.data.message.size() <= 2000));
    }

    match /landingLeads/{leadId} {
      allow read, update, delete: if isAdmin();
      // Exit-intent capture on the logged-out consumer landing page — same
      // reasoning as trainerLeads above: no auth yet at submit time, so this
      // is locked to the exact expected shape instead of a wide-open create.
      allow create: if request.resource.data.keys().hasAll(['email', 'createdAt'])
        && request.resource.data.keys().hasOnly(['email', 'createdAt'])
        && request.resource.data.email is string && request.resource.data.email.size() > 0 && request.resource.data.email.size() <= 320;
    }

    // ── 1:1 Coaching applications (intake form → admin review) ───────────
    match /coachingApplications/{appId} {
      allow read: if isAuthed() && (resource.data.userId == uid() || isAdmin());
      allow create: if isAuthed() && request.resource.data.userId == uid();
      allow update, delete: if isAdmin();
    }

    // ── Config documents (membership, hiddenMocks, etc.) ─────────────────
    match /config/{configId} {
      // membership + coachingPlans + membershipPlans power the public
      // pricing section on the logged-out landing page — everything else in
      // this collection (notifications, hiddenMocks) stays authed-only.
      allow read: if isAuthed() || configId in ['membership', 'coachingPlans', 'membershipPlans'];
      allow write: if isAdmin();
    }

    // ── Push subscriptions ────────────────────────────────────────────────
    // One doc per registered device at .../devices/{deviceId} — not one doc
    // per user — so subscribing on a second device doesn't silently
    // overwrite the first device's subscription.
    match /pushSubscriptions/{userId}/devices/{deviceId} {
      allow read, write: if isAuthed() && uid() == userId;
      allow read: if isAdmin();
    }

    // ── User preferences (theme, etc.) ────────────────────────────────────
    match /userPreferences/{userId} {
      allow read, write: if isAuthed() && uid() == userId;
    }

    // ── Exercise video library ────────────────────────────────────────────
    match /exerciseLibrary/{videoId} {
      allow read:  if isAuthed();
      allow write: if isAdmin();
    }

    // ── PR Wall — community-posted personal records (trust/verification) ──
    // Read is authed-only here; the public/pending split (only approved
    // posts + your own pending one) is filtered client-side, not by rule.
    function prBanActive() {
      let ban = exists(/databases/$(database)/documents/users/$(uid()))
        ? get(/databases/$(database)/documents/users/$(uid())).data.get('prBan', null)
        : null;
      return ban != null && (ban.until == null || ban.until > request.time);
    }

    match /prPosts/{postId} {
      allow read:   if isAuthed() && notTfaPending();
      allow create: if isAuthed() && notTfaPending()
        && request.resource.data.userId == uid()
        && request.resource.data.moderationStatus == 'pending'
        && !prBanActive();
      // Only admins can touch moderation/verification state (that's the
      // whole point of the review gate) — the app never lets a post's own
      // author edit it, only delete it, so there's no legitimate case for
      // an author-owns-it update clause here. Anyone signed in can like or
      // unlike, one at a time, adding/removing exactly their own uid from
      // likedBy with a matching +1/-1 on likeCount — without the exact-uid
      // and exact-delta checks a client could call Firestore directly and
      // set likeCount to anything, or like on another user's behalf.
      allow update: if isAuthed() && (
        isAdmin() ||
        (notTfaPending() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likeCount', 'likedBy']) &&
          (
            (request.resource.data.likeCount == resource.data.likeCount + 1
              && request.resource.data.likedBy == resource.data.get('likedBy', []).concat([uid()])
              && !(uid() in resource.data.get('likedBy', []))) ||
            (request.resource.data.likeCount == resource.data.likeCount - 1
              && request.resource.data.likedBy == resource.data.get('likedBy', []).removeAll([uid()])
              && (uid() in resource.data.get('likedBy', [])))
          ))
      );
      allow delete: if isAuthed() && (resource.data.userId == uid() || isAdmin());
    }

    // ── Client goals (trainer/admin sets, client checks in on progress) ───
    match /goals/{goalId} {
      allow read: if isAuthed() && (resource.data.userId == uid() || isAdminOrOwnTrainer(resource.data.userId)) && notTfaPending();
      allow create: if isAdminOrOwnTrainer(request.resource.data.userId);
      // Client can only touch currentValue on their own goal (status is
      // still coach-controlled — e.g. marking it missed); staff can edit
      // anything for their own clients.
      allow update: if isAuthed() && (
        isAdminOrOwnTrainer(resource.data.userId) ||
        (resource.data.userId == uid() && notTfaPending() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentValue']))
      );
      allow delete: if isAdminOrOwnTrainer(resource.data.userId);
    }

    // ── PT test results (self-logged, read by owner + staff) ────────────────
    match /ptTestResults/{resultId} {
      allow read: if isAuthed() && notTfaPending() && (resource.data.userId == uid() || isAdminOrOwnTrainer(resource.data.userId));
      allow create: if isAuthed() && notTfaPending() && request.resource.data.userId == uid();
      allow update: if false;
      allow delete: if isAuthed() && notTfaPending() && (resource.data.userId == uid() || isAdminOrOwnTrainer(resource.data.userId));
    }

    // Body progress photos — private to the owning user and their own
    // assigned trainer (or admin) only.
    match /progressPhotos/{photoId} {
      allow read:   if isAuthed() && notTfaPending() && (resource.data.userId == uid() || isAdminOrOwnTrainer(resource.data.userId));
      allow create: if isAuthed() && notTfaPending() && request.resource.data.userId == uid();
      allow delete: if isAuthed() && notTfaPending() && (resource.data.userId == uid() || isAdmin());
    }

  }
}
