rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthed() {
      return request.auth != null;
    }

    // Admin role lives in Firestore (users/{uid}.role), not an Auth custom claim
    function isAdmin() {
      return isAuthed() &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Exercise library videos — admin write, authenticated read
    match /exerciseLibrary/{allPaths=**} {
      allow read: if isAuthed();
      allow write: if isAdmin();
    }

    // User-specific files (profile photos, etc.)
    match /users/{userId}/{allPaths=**} {
      allow read, write: if isAuthed() && request.auth.uid == userId;
    }

    // Community channel post images/attachments
    match /community/{channelId}/{allPaths=**} {
      allow read: if isAuthed();
      allow write: if isAuthed();
    }

    // PR Wall — user-uploaded PR photos/videos, visible to the whole community
    match /prPosts/{userId}/{allPaths=**} {
      allow read: if isAuthed();
      allow write: if isAuthed() && request.auth.uid == userId;
    }

    // App branding (logo) — must be publicly readable since it shows on
    // login/register pages before the visitor is authenticated
    match /branding/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
