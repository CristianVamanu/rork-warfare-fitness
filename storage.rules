rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthed() {
      return request.auth != null;
    }

    // Admin role lives in Firestore (users/{uid}.role), not an Auth custom claim
    function isAdmin() {
      return isAuthed() &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Every user-writable path is bounded: images or video only, no SVG (it
    // executes as active content when served back), and a size ceiling.
    // There was no constraint of any kind before — any signed-in account
    // could fill the bucket under its own prefix with anything at all.
    function isMedia() {
      return request.resource.contentType.matches('(image|video)/.*')
        && !request.resource.contentType.matches('image/svg.*');
    }
    function withinSize(maxBytes) {
      return request.resource.size <= maxBytes;
    }

    // Exercise library videos — admin write, authenticated read
    match /exerciseLibrary/{allPaths=**} {
      allow read: if isAuthed();
      allow write: if isAdmin();
    }

    // User-specific files (profile photos, etc.)
    match /users/{userId}/{allPaths=**} {
      allow read: if isAuthed() && request.auth.uid == userId;
      allow write: if isAuthed() && request.auth.uid == userId && isMedia() && withinSize(200 * 1024 * 1024);
    }

    // Community channel post images/attachments — uploaded to
    // community/{uid}/... (see uploadUserContent() in src/lib/uploadVideo.ts).
    // Previously matched on channelId with no ownership check at all
    // (allow write: if isAuthed()), letting any signed-in user write or
    // overwrite a file anywhere under /community/, not just their own
    // uploads — inconsistent with every other rule in this file, which all
    // scope writes to the uploader's own uid.
    match /community/{userId}/{allPaths=**} {
      allow read: if isAuthed();
      allow write: if isAuthed() && request.auth.uid == userId && isMedia() && withinSize(200 * 1024 * 1024);
    }

    // PR Wall — user-uploaded PR photos/videos, visible to the whole community
    match /prPosts/{userId}/{allPaths=**} {
      allow read: if isAuthed();
      allow write: if isAuthed() && request.auth.uid == userId && isMedia() && withinSize(200 * 1024 * 1024);
    }

    // Support request attachments — screenshots and short screen recordings
    // uploaded from the support form (see uploadUserContent(..., 'support')).
    // Private to the member and staff: a screenshot of a billing problem is
    // not community content. Read used to be isAuthed() — any signed-in
    // account that had the URL could open it.
    match /support/{userId}/{allPaths=**} {
      allow read: if isAuthed() && (request.auth.uid == userId || isAdmin());
      allow write: if isAuthed() && request.auth.uid == userId && isMedia() && withinSize(20 * 1024 * 1024);
    }

    // App branding (logo) — must be publicly readable since it shows on
    // login/register pages before the visitor is authenticated
    match /branding/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Deny everything else
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
