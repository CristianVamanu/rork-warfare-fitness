# Firebase — required at boot, cannot be moved into the admin dashboard
# (the app needs these to even connect to Firestore in the first place)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK — required for cron jobs, admin API routes, and the
# encrypted-secrets store below
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Master encryption key for admin-panel API keys (Integrations tab).
# Generate once per deployment with: openssl rand -base64 32
# This is the ONLY thing that must live in env vars on every install —
# every other integration key (OpenAI, Stripe, R2, VAPID) can be entered
# from the admin dashboard and is encrypted with this key before storage.
ENCRYPTION_KEY=

# Everything below is optional to set here — it can instead be configured
# from Admin → Integrations after first deploy. Env vars act as a fallback
# if no value has been saved from the dashboard.

# Cloudflare R2 (no egress fees) — alternative to Firebase Storage for exercise videos
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# OpenAI
OPENAI_API_KEY=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Server-to-server auth for the notification cron endpoint
CRON_SECRET=
