# Firebase — required at boot, cannot be moved into the admin dashboard
# (the app needs these to even connect to Firestore in the first place)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK — required for cron jobs, admin API routes, and the
# encrypted-secrets store below
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Master encryption key for admin-panel API keys (Integrations tab).
# Generate once per deployment with: openssl rand -base64 32
# This is the ONLY thing that must live in env vars on every install —
# every other integration key (OpenAI, Stripe, R2, VAPID) can be entered
# from the admin dashboard and is encrypted with this key before storage.
ENCRYPTION_KEY=

# Everything below is optional to set here — it can instead be configured
# from Admin → Integrations after first deploy. Env vars act as a fallback
# if no value has been saved from the dashboard.

# Cloudflare R2 (no egress fees) — alternative to Firebase Storage for exercise videos
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# OpenAI
OPENAI_API_KEY=

# Stripe
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Server-to-server auth for the notification cron endpoint
CRON_SECRET=

# Ad conversion tracking — both optional. Leaving either blank disables that
# pixel entirely (see components/ui/ConsentGatedScripts.tsx); both only load
# after a visitor accepts cookies. Meta Pixel ID from Events Manager;
# GA4 Measurement ID (G-XXXXXXXXXX) from Admin -> Data Streams.
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Sentry (error monitoring) — optional but recommended. Sign up free at
# sentry.io, create a Next.js project, and paste its DSN here. Must be a
# real boot-time env var (not dashboard-configurable) since it's needed the
# moment the client bundle loads, before any Firestore config fetch could
# resolve it. Leaving it blank disables Sentry entirely — nothing else
# breaks.
NEXT_PUBLIC_SENTRY_DSN=
# Optional — only needed for readable (un-minified) stack traces via
# source-map upload at build time. Leave blank to skip that step.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# Cloudflare Turnstile (optional) — bot protection on the two public lead
# forms. Both must be set for it to activate; with neither set the forms
# behave exactly as before. Get keys at dash.cloudflare.com > Turnstile.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional kill switch for the web installer. When set, /install can no
# longer complete setup (it never sends this value — a client-visible
# "secret" is not a secret) and setup must be driven by a direct POST to
# /api/install carrying it. Leave blank unless you want that.
INSTALL_SECRET=
