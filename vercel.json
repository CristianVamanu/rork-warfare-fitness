{
  "version": 2,
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npx expo export --platform web",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/backend/hono.ts"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/backend/hono.ts" },
    { "src": "/(.*)", "dest": "/index.html" }
  ]
}
