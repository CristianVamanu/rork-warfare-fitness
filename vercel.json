{
  "version": 2,
  "framework": null,
  "installCommand": "npm install",
  "buildCommand": "npx expo@54 export --platform web",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/((?!_expo|assets).*)", "destination": "/index.html" }
  ]
}
