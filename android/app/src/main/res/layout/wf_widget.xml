<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/wf_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/wf_widget_bg"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="14dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:minWidth="64dp">
        <TextView
            android:id="@+id/wf_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0"
            android:textColor="#F5A623"
            android:textSize="32sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/wf_streak_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="day streak"
            android:textColor="#A9A9A9"
            android:textSize="11sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WARFARE FITNESS"
            android:textColor="#F5A623"
            android:textSize="10sp"
            android:letterSpacing="0.12"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/wf_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Today's workout"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/wf_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Open the app to load your plan"
            android:textColor="#A9A9A9"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
