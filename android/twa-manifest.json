{
  "packageId": "com.warfarefitness.app",
  "host": "warfarefitness.com",
  "name": "Warfare Fitness",
  "launcherName": "Warfare",
  "display": "standalone",
  "themeColor": "#F5A623",
  "themeColorDark": "#0A0A0A",
  "navigationColor": "#0A0A0A",
  "navigationColorDark": "#0A0A0A",
  "navigationDividerColor": "#0A0A0A",
  "navigationDividerColorDark": "#0A0A0A",
  "backgroundColor": "#0A0A0A",
  "enableNotifications": true,
  "startUrl": "/dashboard?source=android",
  "iconUrl": "https://warfarefitness.com/icons/icon-512x512.png",
