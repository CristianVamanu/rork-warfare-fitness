EXPO_PUBLIC_REVENUECAT_API_KEY=your_revenuecat_api_key_here
# Optional (legacy) per-platform keys. If EXPO_PUBLIC_REVENUECAT_API_KEY is set, these are not required.
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=your_ios_api_key_here
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=your_android_api_key_here

# Android app (Play Store, Trusted Web Activity) — see android/README.md
# SHA-256 fingerprints of the upload key AND the Play App Signing key, comma-separated.
ANDROID_PACKAGE_NAME=com.warfarefitness.app
ANDROID_SHA256_FINGERPRINTS=
