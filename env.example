# ─── RevenueCat (native in-app purchases) ────────────────────────────────────
EXPO_PUBLIC_REVENUECAT_API_KEY=your_revenuecat_api_key_here
# Optional per-platform keys — not required if the key above is set.
EXPO_PUBLIC_RC_IOS_KEY=your_ios_revenuecat_key_here
EXPO_PUBLIC_RC_ANDROID_KEY=your_android_revenuecat_key_here

# ─── OpenAI (food analyzer, AI trainer, program generation) ──────────────────
OPENAI_API_KEY=sk-...

# ─── Supabase (subscription storage, Stripe webhook) ─────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ─── API base URL (leave blank to use same-origin on Vercel web) ──────────────
EXPO_PUBLIC_API_BASE_URL=

# ─── Firebase (push notifications, cloud storage) ────────────────────────────
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
